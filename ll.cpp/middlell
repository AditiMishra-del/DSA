class solution{
    public:
    listnode * middlenode(listnode* head){
        int count=0;
        listnode* temp=head;
        while(temp!=NULL){
            count++;
            temp=temp->next;
        }
        count/=2;
        temp=head;
        while(count--){
           temp =temp->next;
        }
        return temp;
    }
