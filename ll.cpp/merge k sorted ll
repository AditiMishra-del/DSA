//merge k sorted ll  tc=o(k^2 n)

node *mergelists(node *arr[],int k){
    node *head=arr[0];
    for(i=1;i<k;i++){
        head=merge(head,arr[i]);
    }
    return head;
}

//method 2 using merge sort tc=o(knlogk) sc=o(logk)

node *mergesort(node *arr[],int start,int end){
    int mid=start+(end-start)/2;
    
    if(start>=end) return;
    
    mergesort(arr,start,mid);
    mergesort(arr,mid+1,end);
    arr[start]=merge(arr[start],arr[mid+1]);
}


node *mergelists(node *arr[],int k){
    mergesort(arr,0,k-1);
    return arr[0];
}
