// merging 2 ll 

class node{
    public: 
    int data;
    node *next,*bottom;
}

node *merge(node *head1,node *head2) {
	//lec 87 flattening a ll 
	node *head=new node(0);
	node *tail=head;
	while(head1 && head2){
	    if(head1->data<=head2->data){
	        tail->bottom=head1;
	        head1=head1->bottom;
	        tail=tail->bottom;
	        tail->bottom =NULL;
	    }
	    else{
	       tail->bottom=head2;
	       head2=head2->bottom;
	       tail=tail->bottom;
	       tail->bottom =NULL; 
	    }
	    if(head1) tail->bottom =head1;
	    else    tail->bottom =head2;
	    
	    return head->next;
	}
}

//merging more then 2 tc=o(n^2 m) sc=o(1)

node fll(node *root){
    node *head1, *head2, *head3;
    while(root->next){
     head1=root;
     head2=root->next;
     head3=root->next->next;
     head1->next=NULL;
     head2->next=NULL;
     
     root =merge(head1,head2);
     root->next=head3;
    }
}
