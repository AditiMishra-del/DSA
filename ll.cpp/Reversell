#include <bits/stdc++.h>
using namespace std;
class solution{
    public:
    listnode * reverselist(listnode *head){
        vector<int>ans;
        listnode* temp=head;
        while(temp!=NULL){
            ans.push_back(temp->value);
            temp=temp->next;
        }
        int i=ans.size()-1;
        temp=head;
        while(temp){
            temp->value=ans[i];
            i--;
            temp=temp->next;
        }
        return head;
    }
}
