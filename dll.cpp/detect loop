//TLE 0(n^2)
bool(vector<node*>visited,node *curr){
    for(int i=0;i<visited.size();i++){
        if(visited[i]==curr) return 1;
    }
    return 0;
}
bool detectloop(*head){
	node *curr=head;
	vector<node*>visited;
	while(curr!=NULL){
	   if(check(visited,curr)) return 1;
	   visited=push_back(curr);
	   cur=curr->next;
	}
     return 0;
}
