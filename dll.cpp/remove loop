void removeloop(node *head) {
	node *slow=head,*fast=head;
	while(fast&&fast->next){
	    slow=slow->next;
	    fast=fast->next->next;
	    if(slow==fast) break;
	}
	if(fast==NULL && fast->next==NULL) return NULL;
	slow=head;
	while(slow!=fast){
	    slow=slow->next;
	    fast=fast->next;
	}
	while(slow->next!=fast){
	    slow=slow->next;
	}
    slow->next=NULL;
}
