void removeloop(node *head) {
    node *slow=head, *fast=head;
    while(fast!=NULL && fast->next=NULL){
      slow=slow->next;
      fast=fast->next->next;
      if(slow==fast) break;
    }
    if(fast==NULL||fast->next==NULL)  return ;
     int count =1;
     slow=fast->next;
    while(slow!=fast){
     count++;
     slow=slow->next;
    }
    slow=head,fast=head;
    while(count--){
        fast=fast->next;
    }
    while(slow!=fast){
	    slow=slow->next;
	    fast=fast->next;
	}
	while(slow->next!=fast){
	    slow=slow->next;
	}
    slow->next=NULL;
}
