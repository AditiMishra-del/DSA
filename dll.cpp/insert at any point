
int main() {
    int pos;
    cin>>pos;
	if(pos==0) {
	    if(head==NULL){
	        head=new node(5);
	    }
	    else{
	        node *temp=new node(5);
	        temp->next=head;
	        head->prev=temp;
	        head=temp;
	    }
	}
	else{
	node *curr=head;
	while(--pos){
	    curr=curr->next;
	}
	if(curr->next==NULL){
	    node *temp=new node(5);
	    temp->prev=curr;
	    curr->next=temp;
	}
	else{
	    node *temp=new node(5);
        temp->next=curr->next;
        temp->prev=curr;
        curr->next=temp;
        temp->next->prev=temp; 
	}
  }
   
