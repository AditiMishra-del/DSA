class Solution {
    
  public:
    vector<int> nextLargerElement(vector<int>& arr) {
        // code here
        int n=arr.size();
       stack<int>s;
       vector<int>ans(n,-1);
       for(int i=n-1;i>=0;i--){
            while(!s.empty() && arr[s.top()]<=arr[i])
                   s.pop();
                if(!s.empty())
                ans[i]=arr[s.top()];
               
               
               s.push(i);
           
       }
       return ans;
    }
};
