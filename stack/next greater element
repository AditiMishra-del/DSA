class Solution {
    //tle brute force approach tc=o(n^2)
  public:
    vector<int> nextLargerElement(vector<int>& arr) {
        // code here
        vector<int>ans(n,-1);
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                if(arr[j]>arr[i]){
                    ans[i]=arr[j];
                    break;
                }
            }
        }
        return ans;
    }
};
