class Solution {
    
  public:
    vector<int> nextLargerElement(vector<int>& arr) {
        // code here
       stack<int>s;
       vector<int>arr(n,-1);
       for(i=0;i<n;i++){
            while(!s.empty() && arr[s.top()]<arr[i]){
                   ans[s.top()]=arr[i];
                   s.pop();
               }
               s.push(i);
           
       }
       return ans;
    }
};

