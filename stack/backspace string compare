class Solution {
public:
    bool backspaceCompare(string s, string t) {
        stack<char>v; stack<char>a;
        for(int i=0;i<s.size();i++){
            if(s[i]!='#')
             v.push(s[i]);
            else{
                if(!v.empty()) v.pop();
               
            }
            
        }
        for(int i=0;i<t.size();i++){
            if(t[i]!='#')
             a.push(t[i]);
            else{
                if(!a.empty()) a.pop();
                
            }
            
        }
        return v==a;
    }
};
