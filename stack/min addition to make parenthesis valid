class Solution {
public:
    int minAddToMakeValid(string s) {
        stack<char>v;
        int count = 0;
        for(int i=0;i<s.size();i++){
            if(s[i]=='(') 
            v.push(s[i]);
            else{
                if(v.empty()) count++;
                else v.pop();
            }
        }
        return  count+v.size();
    }
};
