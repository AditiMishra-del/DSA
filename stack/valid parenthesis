class Solution {
public:
    bool isValid(string s) {
        stack<char>v;
        for(int i=0;i<s.size();i++){
            if(s[i]=='(' || s[i]=='{' || s[i]=='[') 
             v.push(s[i]);
             else{
              if(v.empty()) return 0;
              else if(s[i]==')'){
                if(v.top()!='(') return 0;
                else v.pop();
              }
             else if(s[i]=='}'){
                if(v.top()!='{') return 0;
                else v.pop();
              }
              else {
                if(v.top()!='[') return 0;
                else v.pop();
              }
            } 
        }
        return v.empty();
    }
};
